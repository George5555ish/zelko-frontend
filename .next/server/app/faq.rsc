f:["$","p",null,{"className":"mt-4 text-base leading-relaxed text-neutral-500","children":"From your report you can generate one AI-recommended outfit that complements your face, eyes, and hair. Free includes that one still; another requires Pro (up to 3). These are generative fashion previews, not medical or clinical advice."}]
10:["$","$L5","What’s free vs paid?",{"delayMs":300,"children":["$","details",null,{"className":"group py-6","children":[["$","summary",null,{"className":"cursor-pointer list-none text-lg font-medium tracking-tight text-neutral-950 marker:content-none","children":["$","span",null,{"className":"flex items-start justify-between gap-4","children":["What’s free vs paid?",["$","span",null,{"className":"mt-1 text-neutral-400 transition group-open:rotate-45","children":"+"}]]}]}],["$","p",null,{"className":"mt-4 text-base leading-relaxed text-neutral-500","children":"Free always includes your overall composite score plus your top 1–2 strongest features, and one AI-recommended outfit still from your report. Paid unlocks the full breakdown, confidence labels, a trackable action checklist, re-upload tracking, and more outfit stills (up to 3)."}]]}]}]
11:["$","$L5","How do recommendations work?",{"delayMs":360,"children":["$","details",null,{"className":"group py-6","children":[["$","summary",null,{"className":"cursor-pointer list-none text-lg font-medium tracking-tight text-neutral-950 marker:content-none","children":["$","span",null,{"className":"flex items-start justify-between gap-4","children":["How do recommendations work?",["$","span",null,{"className":"mt-1 text-neutral-400 transition group-open:rotate-45","children":"+"}]]}]}],["$","p",null,{"className":"mt-4 text-base leading-relaxed text-neutral-500","children":"Weak scores unlock paired recommendations. We separate changeable levers (skin, grooming, brows, photo setup) from photo-sensitive reads (often lighting/angle) and mostly structural ones (like eye spacing). On Pro, only actionable items become your weekly checklist — structural context stays on the report, not as chores."}]]}]}]
12:["$","$L5","How does re-upload tracking work?",{"delayMs":420,"children":["$","details",null,{"className":"group py-6","children":[["$","summary",null,{"className":"cursor-pointer list-none text-lg font-medium tracking-tight text-neutral-950 marker:content-none","children":["$","span",null,{"className":"flex items-start justify-between gap-4","children":["How does re-upload tracking work?",["$","span",null,{"className":"mt-1 text-neutral-400 transition group-open:rotate-45","children":"+"}]]}]}],["$","p",null,{"className":"mt-4 text-base leading-relaxed text-neutral-500","children":"Before comparing two uploads we check lighting and angle consistency. If conditions differ, we flag it. Re-analysis is capped at once per week. Non-improvement is framed as “no significant change detected,” never as a decline."}]]}]}]
